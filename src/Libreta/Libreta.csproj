<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Without this dotnet run switches to the project folder, breaking book paths typed relative
         to wherever the command was actually invoked. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
    <!-- UseStaticFiles serves wwwroot as it is, so precompressed copies would ship unread. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- A trimmed release keeps both whole: YAML and JSON (de)serialization reach their types only by reflection. -->
    <TrimmerRootAssembly Include="Libreta" />
    <TrimmerRootAssembly Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../../docs/format.md" LogicalName="Libreta.Docs.format.md" />
    <EmbeddedResource Include="../../docs/running.md" LogicalName="Libreta.Docs.running.md" />
    <EmbeddedResource Include="formats.yaml" LogicalName="Libreta.formats.yaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets a running app find the wwwroot it was built from and serve that instead of its own copy,
         so editing the interface behaves like editing a book rather than needing a rebuild. -->
    <AssemblyMetadata Include="SourceRoot" Value="$(MSBuildProjectDirectory)" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>